---
import type { LayoutProps } from '@/types'
import ThemeProvider from '../components/ThemeProvider.astro'
import Navigation from '../components/Navigation.astro'
import { socialLinksContent } from '@/content/socialLinksContent'
import { heroContent } from '@/content/hero'
import '../styles/globals.css'

interface Props extends LayoutProps {
  profilePage?: boolean
}

const {
  title,
  description = 'Senior Frontend Engineer based in Sydney with 10+ years of experience in React, TypeScript, frontend architecture, WebGL, automated testing and CI/CD.',
  profilePage = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const homepageURL = new URL('/', Astro.site ?? canonicalURL).href
const socialUrls = socialLinksContent.socialLinks.map((link) => link.url)

const profileImageURL = 'https://cdn.josemianton.com/images/profile.jpg'
const profileImageAlt = 'Josemi Anton, Senior Frontend Engineer'

// Profile structured data is opt-in so ordinary pages are not classified as
// profile pages. The Person uses a stable homepage @id.
const profileSchema = profilePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: canonicalURL.href,
      mainEntity: {
        '@type': 'Person',
        '@id': `${homepageURL}#person`,
        name: heroContent.name,
        jobTitle: heroContent.tagline,
        description,
        url: homepageURL,
        image: profileImageURL,
        homeLocation: {
          '@type': 'Place',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Sydney',
            addressCountry: 'AU',
          },
        },
        worksFor: {
          '@type': 'Organization',
          name: heroContent.currentWork.company,
          url: heroContent.currentWork.url,
        },
        knowsAbout: [
          'React',
          'TypeScript',
          'Frontend Architecture',
          'Automated Testing',
          'CI/CD',
          'WebGL',
          'XR',
        ],
        sameAs: socialUrls,
      },
    }
  : undefined
---

<!doctype html>
<html
  lang='en'
  class='dark'
>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width'
    />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    <link
      rel='canonical'
      href={canonicalURL.href}
    />
    <meta
      name='description'
      content={description}
    />
    <meta
      name='generator'
      content={Astro.generator}
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:site_name'
      content='Josemi Anton'
    />
    <meta
      property='og:title'
      content={title}
    />
    <meta
      property='og:description'
      content={description}
    />
    <meta
      property='og:url'
      content={canonicalURL.href}
    />
    <meta
      property='og:image'
      content={profileImageURL}
    />
    <meta
      property='og:image:width'
      content='1600'
    />
    <meta
      property='og:image:height'
      content='1600'
    />
    <meta
      property='og:image:alt'
      content={profileImageAlt}
    />
    <meta
      property='og:locale'
      content='en_AU'
    />
    <meta
      name='twitter:card'
      content='summary'
    />
    <meta
      name='twitter:title'
      content={title}
    />
    <meta
      name='twitter:description'
      content={description}
    />
    <meta
      name='twitter:image'
      content={profileImageURL}
    />
    <meta
      name='twitter:image:alt'
      content={profileImageAlt}
    />
    <title>{title}</title>
    {
      profileSchema && (
        <script
          is:inline
          type='application/ld+json'
          set:html={JSON.stringify(profileSchema)}
        />
      )
    }
    <ThemeProvider
      defaultTheme='dark'
      storageKey='theme-preference'
    />
  </head>
  <body class='font-sans font-light'>
    <div class='min-h-screen bg-background text-foreground'>
      <header class='container mx-auto px-4 py-2'>
        <Navigation />
      </header>
      <slot />
    </div>
  </body>
</html>
