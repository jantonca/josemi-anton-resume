---
// src/pages/index.astro
import type { HomePageConfig } from '@/types/pages'
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
import Skills from '../components/Skills.astro'
import Education from '../components/Education.astro'
import Experience from '../components/Experience.astro'
import SelectedWork from '../components/SelectedWork.astro'
import Footer from '../components/Footer.astro'
import Contact from '../components/Contact.astro'

// Page configuration
const pageConfig: HomePageConfig = {
  seoTitle: 'Josemi Anton — Senior Frontend Engineer',
  seoDescription:
    'Senior Frontend Engineer based in Sydney with 10+ years of experience in React, TypeScript, frontend architecture, WebGL, automated testing and CI/CD.',
  sections: {
    hero: true,
    about: true,
    experience: true,
    selectedWork: true,
    skills: true,
    education: true,
    contact: true,
    footer: true,
  },
}
---

<Layout
  title={pageConfig.seoTitle}
  description={pageConfig.seoDescription}
  profilePage
>
  <main class='bg-background'>
    {pageConfig.sections.hero && <Hero />}
    {pageConfig.sections.about && <About />}
    {pageConfig.sections.experience && <Experience />}
    {pageConfig.sections.selectedWork && <SelectedWork />}
    {pageConfig.sections.skills && <Skills />}
    {pageConfig.sections.education && <Education />}
    {pageConfig.sections.contact && <Contact />}
    {pageConfig.sections.footer && <Footer />}
  </main>
</Layout>
